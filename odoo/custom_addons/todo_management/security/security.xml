<odoo>
    <record id='todo_category' model='ir.module.category'>
        <field name='name'>Todo Management</field>
    </record>



    <record id='todo_users_group' model='res.groups'>
        <field name='name'>Users</field>
        <field name='category_id' ref='todo_management.todo_category'/>
    </record>

    <record id='todo_managers_group' model='res.groups'>
        <field name='name'>Managers</field>
        <field name='category_id' ref='todo_management.todo_category'/>
    </record>

   <record id='todo_record_by_user' model='ir.rule'>
    <field name='name'>record.by.user</field>
    <field name='model_id' ref='todo_management.model_todo_task'/>
    <field name='domain_force'>[('assign_to_id','=',user.id)]</field>
    <field name='groups' eval='[(4,ref("todo_management.todo_users_group"))]'/>
    <field name='perm_read' eval='True'/>
    <field name='perm_write' eval='True'/>
    <field name='perm_create' eval='False'/>
    <field name='perm_unlink' eval='False'/>
   </record>
</odoo>