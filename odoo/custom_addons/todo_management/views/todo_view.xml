<odoo>
       <record id="todo_action" model="ir.actions.act_window">
        <field name="name">All tasks</field>
        <field name="res_model">todo.task</field>
    </record>

    <menuitem
    name='All Tasks'
    id= 'todo_menu'
    parent='todo_root_menu'
    action='todo_action'
    />


    <record id="todo_view_tree" model="ir.ui.view">
        <field name="name">todo tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_late == True">
                <field name="name" />
                <field name='assign_to_id'/>
                <field name="due_date" />
                <field name="status" />
                <field name='is_late' />
            </tree>
        </field>
    </record>

     <record id="todo_view_form" model="ir.ui.view">
        <field name="name">todo form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form>
                <header> 
                    <button
                    name='action'
                    type='object'
                    string='action'
                    class='btn_primary'
                    
                    />
                    <button 
                    name='action_mark_in_progress'
                    type='object'
                    string='Mark as In Progress'
                    class='btn_primary'
                    invisible='status != "new"'
                    groups="todo_management.todo_managers_group"/>
       
                    <button 
                    name='action_mark_completed'
                    type='object'
                    string='Mark as Completed'
                    class='btn_primary'
                    invisible='status != "in progress"'
                    />
                    
                    <field name='status' widget='statusbar'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ref" />
                        <h1>
                            <field name="ref" />
                        </h1>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h2>
                            <field name="name" readonly='is_managers_group != True'/>
                        </h2>
                    </div>
               
                        <group string='General Info'>
                            <field name="description" />
                            <field name='assign_to_id' readonly='is_managers_group != True'/>
                            <field name="due_date" readonly='is_managers_group != True'/>
                            <field name="estimated_time" readonly='is_managers_group != True'/>
                            <field name='active' invisible='1'/>
                            <field name='is_managers_group' invisible='1'/>
                            
                        </group>
                        <notebook>
                            <page string='TimeSheet'>
                                <field name='line_ids'>
                                    <tree editable='buttom'>
                                        <field name='date'/>
                                        <field name='duration'/>
                                        <field name='note'/>
                                    </tree>

                                </field>

                            </page>
                        </notebook>

                </sheet>
                <div class='oe_chatter'>
                <field name='message_follower_ids'/>
                <field name='activity_ids'/>
                <field name='message_ids'/>
                </div>
            </form>
        </field>
    </record>



    <record id="todo_view_search" model="ir.ui.view">
        <field name="name">todo search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="assign_to_id" />
                <field name="name" /> 
    <!-- Filters -->
  <filter name="is_new" string="New" domain="[('status','=','new')]"/>
                <filter name="is_in_progress" string="In Progress" domain="[('status','=','in progress')]"/>
                <filter name="is_completed" string="Completed" domain="[('status','=','completed')]"/> 

    <!-- groups -->
   <filter name="assgin_to_group" string="Assign To" context= "{'group_by' : 'assign_to_id'}"/>
   <filter name="status_group" string="Status" context= "{'group_by' : 'status'}"/>
   <filter name="due_date_group" string="Due Date" context= "{'group_by' : 'due_date'}"/>

            </search>
        </field>
    </record>

    <record id='todo_closed_server_action' model='ir.actions.server'>
        <field name='name'>Close Task</field>
        <field name='model_id' ref='model_todo_task'/>
        <field name='binding_model_id' ref='model_todo_task'/>
        <field name='state'>code</field>
        <field name='code'>
            action = records.action_mark_closed()
        </field>
        <field name="groups_id" eval="[(4, ref('todo_management.todo_managers_group'))]"/>
    </record>

    <record id='assign_bulk_partner_server_action' model='ir.actions.server'>
        <field name='name'>Bulk Assigning</field>
        <field name='model_id' ref='model_todo_task'/>
        <field name='binding_model_id' ref='model_todo_task'/>
        <field name='state'>code</field>
        <field name='code'>
            action = records.open_assign_bulk_partner_wizard()
        </field>
         <field name="groups_id" eval="[(4, ref('todo_management.todo_managers_group'))]"/>
    </record>

    <record id='todo_check_is_late_cron' model='ir.cron'>
        <field name='name'>Todo_Task: check is late</field> 
        <field name='model_id' ref='model_todo_task'/>
        <field name='state'>code</field>
        <field name='code'>
            model._check_if_late()  
        </field>

        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name='numbercall'>-1</field>
        <field name='active'>True</field>
    </record>
</odoo>