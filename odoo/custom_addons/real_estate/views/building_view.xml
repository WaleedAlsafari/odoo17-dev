<odoo>
    <!-- This is a tree view -->
    <!-- create a record/row within model/table "ir.ui.view" -->
    <record id="building_view_tree" model="ir.ui.view">
        <field name="name">building tree</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <tree multi_edit='1' create='1' edit='1' delete='1' >
                <field name="num" />
                <field name="code" />
            </tree>
        </field>
    </record>
