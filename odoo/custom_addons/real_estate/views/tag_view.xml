<odoo>
    <!-- This is a tree view -->
    <!-- create a record/row within model/table "ir.ui.view" -->
    <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag tree</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <tree multi_edit='1' create='1' edit='1' delete='1'>
                <field name="name" />
            </tree>
        </field>
    </record>


    <!-- This is a form view -->
    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag form</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                </sheet>
            </form>
        </field>
    </record>


    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">tag</field>
    </record>


    <menuitem
        id="tag_menu_item"
        name="tags"
        parent="real_estate_root_menu"
        action="tag_action"
        groups= 'real_estate.property_manager_group'
    />
</odoo>