<odoo>
    <!-- This is a tree view -->
    <!-- create a record/row within model/table "ir.ui.view" -->
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree multi_edit='1' create='1' edit='1' delete='1' class='custom_header' decoration-danger="is_late == True">
                <header>
                    <button name='property_xlsx_report' type='object' string='Print xlsx Report' class='btn-primary'/>
                </header>
                <field name="name" />
                <field name="owner_id" />
                <field name="owner_phone" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="state" />
                <field name='is_late' invisible='1'/>
                <field name="garden" optional='1' />
            </tree>
        </field>
    </record>

    <!-- This is a search view for searching -->
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="postcode" />
                <field name="name" /> 
    <!-- Filters -->
   <filter name="is_garden" string="With Garden" domain="[('garden','=',True)]"/>
                <filter name="is_not_garden" string="Without Garden" domain="[('garden','=',False)]"/>
                <filter name="is_garage" string="With Garage" domain="[('garage','=',True)]"/> 
                <filter name='is_archived' string='Archived' domain='[("active","!=",True)]'/>

    <!-- groups -->
     <filter name="garden_group" string="Garden" context= "{'group_by' : 'garden'}"/>

            </search>
        </field>
    </record>


    <!-- This is a form view -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name='action_mark_draft'
                        type='object'
                        string='Mark as draft'
                        class='btn-primary'
                        invisible="state in ('draft','closed')"
                    />
                    <button name='action_mark_pending'
                        type='object'
                        string='Mark as pending'
                        class='btn-primary'
                        invisible="state != 'draft'"
                    />
                    <button name='action_mark_sold'
                        type='object'
                        string='Mark as Sold'
                        class='btn-primary'
                        invisible="state != 'pending'"
                    />
                    <button name='get_property_api'
                        type='object'
                        string='Get Properties from API'
                        class='btn-primary'
                    />

                    <field name='state' widget='statusbar' />
                </header>

                <sheet readonly='state == "closed"'>
                    <field name='state' invisible='1'/>
                    <div name='button_box' class='oe_button_box'>
                        <button
                        name='open_releated_owner_button'
                        type='object'
                        string='Owner'
                        icon='fa-user'
                        invisible='not owner_id'
                        />

                    </div>
                    <widget name='web_ribbon' title='Archived' bg_color='text-bg-danger' invisible='active'/>
                    <widget name='web_ribbon' title='Sold' bg_color='text-bg-success' invisible='state != "sold"'/>
                    <div class="oe_title">
                        <label for="ref" />
                        <h1>
                            <field name="ref" />
                        </h1>
                    </div>
                    <label for='name'/>
                    <h3>
                        <field name='name'/>
                    </h3>
                    <group>
                        <group string='General Info'>
                            <field name="postcode" />
                            <field name="date_availability" />
                            <field name="expected_selling_date" />
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="diff_price"/>
                            <field name="bedrooms" />
                            <field name="living_area" />
                            <field name="facades" />
                        </group>

                        <group string='Addtional Info'>
                            <field name="garage" />
                            <field name="garden" />
                            <field name="garden_area" />
                            <field name="garden_orientation" />
                        </group>

                        <group string='Owner Info'>
                            <field name="owner_id" />
                            <field name="owner_phone" />
                            <field name="tag_ids" widget='many2many_tags' />
                        </group>

                        <group>
                            <field name="description" required="1"/>
                            <field name='active' invisible='1'/>
                        
                        </group>

                    </group>
                    
                    <notebook>
                        <page string='Bedrooms'>
                           <field name='line_ids'>
                            <tree editable='buttom'>
                            <field name='description'/>
                            <field name='area'/>
                           </tree>
                           </field>
                           
                        </page>
                    </notebook>
                </sheet>
                <div class='oe_chatter'>
                <field name='message_follower_ids'/>
                <field name='activity_ids'/>
                <field name='message_ids'/>
                </div>
            </form>
        </field>
    </record>


    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
    </record>


    <menuitem
        id="estate_property_menu_item"
        name="Properties"
        parent="estate_property_menu"
        action="property_action"
    />

    <!-- Server Action -->
    <record id='property_closed_server_action' model='ir.actions.server'>
       <field name='name'>Close Property</field>
       <field name='model_id' ref='model_estate_property'/>
       <field name='binding_model_id' ref='model_estate_property'/>
       <field name='state'>code</field>
       <field name='code'>
        action= records.action_mark_closed()
       </field>
    </record>

     <record id='change_state_server_action' model='ir.actions.server'>
        <field name='name'>Change State</field>
        <field name='model_id' ref='model_estate_property'/>
        <field name='binding_model_id' ref='model_estate_property'/>
        <field name='state'>code</field>
        <field name='code'>
            action = records.show_change_state_wizard()
        </field>

    </record>

    <!-- Automated Action -->
    <record id='check_expected_selling_date_cron' model='ir.cron'>
    <field name='name'>Property: Check selling date</field>
    <field name='model_id' ref='model_estate_property'/>
    <field name='state'>code</field>
    <field name='code'>
        model.check_expected_selling_date()
    </field>
    <field name='interval_number'>1</field>
    <field name='interval_type'>days</field>
    <!-- if -1 it means call it everyday otherwise just put any number represent how many days (depends on the interval type) -->
    <field name='numbercall'>-1</field>
    <field name='active'>True</field>

    </record>
</odoo>