<odoo>

    <record id="change_state_wizard_form" model="ir.ui.view">
        <field name="name">Change State Form</field>
        <field name="model">change.state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name='property_id' invisible='1' readonly='1'/>
                    <field name='new_state' required='1'/>
                    <field name='reason' required='1'/>
                </group>
                <footer>
                    <button string='Confirm' type='object' name='confirm_action' class='btn-primary'/>
                    <button string='Cancel' special='cancel' class='btn-secondary'/>
                </footer>
            </form>
        </field>
    </record>

    <record id="change_state_wizard_action" model="ir.actions.act_window">
        <field name="name">Change State actions</field>
        <field name="res_model">change.state</field>
        <field name='target'>new</field>
        <field name='view_mode'>form</field>
    </record>


</odoo>