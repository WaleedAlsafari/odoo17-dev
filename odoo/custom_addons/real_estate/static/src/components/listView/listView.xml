<template xml:space="preserve">
    <t t-name="real_estate.ListView">
     
       <h1>Properties</h1>
       
       <button class='btn-primary' t-on-click='createProperty'>Create</button>


<div class="property_list_view_wrapper">
    <table class="property_list_view">
        <thead>
            <tr>
                <th class="prop_checkbox_cell"></th>
                <th>Name</th>
                <th>Postcode</th>
                <th class="prop_field_numeric">Selling Price</th>
                <th>Date Availability</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach='state.records' t-as='record' t-key='record.id'>
            <tr>
                <td class="prop_checkbox_cell">
                    <input type="checkbox" />
                </td>
                <td class="prop_field_name"><a href="#"><t t-esc='record.name'/></a></td>
                <td><t t-esc='record.postcode'/></td>
                <td class="prop_field_numeric"><t t-esc='record.selling_price'/></td>
                <td><t t-esc='record.date_availability'/></td>
            </tr>
            </t>
        </tbody>
    </table>
</div>
    </t>
</template>