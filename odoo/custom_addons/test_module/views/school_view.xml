<odoo>
      	<record id="view_school_tree" model="ir.ui.view">
      		<field name="name">penygon.school.tree.view</field>
      		<field name="model">penygon.school</field>
      		<field name="arch" type="xml">
      			<tree string="School Tree">
      				<field name="name" string="School Name"/>
      				<field name="average_aggregate"/>
      				<field name="date"/>
      				<field name="datetime_t"/>
      			</tree>
      		</field>
      	</record>
      	
      	<record id="view_school_form" model="ir.ui.view">
      		<field name="name">penygon.school.form.view</field>
      		<field name="model">penygon.school</field>
      		<field name="arch" type="xml">
      			<form string="School Form">
      				<group col="4">
	      				<field name="name" string="School Name" placeholder="Enter School Name.."/>
	      				<field name="average_aggregate"/>
	      				<field name="date"/>
	      				<field name="datetime_t"/>
      				</group>
      				<group string="Students">
      					<field name="student_ids" nolabel="1"/>
      				</group>
      			</form>
      		</field>
		</record>      		
      	
     <record id="action_view_school" model="ir.actions.act_window">
            <field name="name">School</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">penygon.school</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
      </record>
      
      
      
</odoo>