<odoo>
      	<record id="view_teacher_tree" model="ir.ui.view">
      		<field name="name">penygon.teacher.tree.view</field>
      		<field name="model">penygon.teacher</field>
      		<field name="arch" type="xml">
      			<tree string="Teacher Tree">
      				<field name="name"/>
      			</tree>
      		</field>
      	</record>
      	
      	<record id="view_teacher_form" model="ir.ui.view">
      		<field name="name">penygon.teacher.form.view</field>
      		<field name="model">penygon.teacher</field>
      		<field name="arch" type="xml">
      			<form string="Teacher Form">
      				<group col="4">
	      				<field name="name"/>
	      				<field name="user_id" required="1"/>
      				</group>
      				<group string="Students">
      					<field name="student_ids" nolabel="1"/>
      				</group>
      			</form>
      		</field>
		</record>      		
      	
     <record id="action_teacher_master" model="ir.actions.act_window">
            <field name="name">Teacher</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">penygon.teacher</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
      </record>
      
      
      
</odoo>