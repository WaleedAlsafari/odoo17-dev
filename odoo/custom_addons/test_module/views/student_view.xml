<odoo>
		<record id="view_student_search" model="ir.ui.view">
      		<field name="name">penygon.student.search.view</field>
      		<field name="model">penygon.student</field>
      		<field name="arch" type="xml">
      			<search string="Student Search">
      				<field name="name"/>
      				<field name="school_id"/>
      			</search>
      		</field>
      	</record>
		

      	<record id="view_student_tree" model="ir.ui.view">
      		<field name="name">penygon.student.tree.view</field>
      		<field name="model">penygon.student</field>
      		<field name="arch" type="xml">
      			<tree string="School Tree">
      				<field name="name"/>
      				<field name="active" invisible="1"/>
      			</tree>
      		</field>
      	</record>
      	
      	<record id="view_student_form" model="ir.ui.view">
      		<field name="name">penygon.student.form.view</field>
      		<field name="model">penygon.student</field>
      		<field name="arch" type="xml">
      			<form string="Student Form">
      				<header>
      					<button name="action_set_active" string="Activate" type="object" class="oe_highlight" attrs="{'invisible': [('active', '=', True)]}" groups="test_module.group_school_admin"/>
      					<button name="action_set_deactive" string="Deactivate" type="object" class="oe_highlight" attrs="{'invisible': [('active', '!=', True)]}" groups="test_module.group_school_admin"/>
      					<button name="%(test_module.action_assign_teacher_student)d" type="action" string="Rename" class="oe_highlight"/>
      				</header>
	      			<sheet>
	      				<group col="4">
	      					<field name="image" widget="image" class="oe_avatar" />
		      				<field name="name" attrs="{'readonly': [('active', '!=', True)]}"/>
		      				<field name="school_id" widget="selection" attrs="{'readonly': [('active', '!=', True)]}"/>
		      				<field name="active" invisible="1"/>
	      				</group>
	      				<notebook>
	      					<page string="Teachers">
	      						<field name="teacher_ids" widget="many2many_checkboxes" attrs="{'readonly': [('active', '!=', True)]}"/>
	      					</page>
	      					<page string="Logs" attrs="{'invisible': [('student_log_ids', '=', [])]}">
	      						<field name="student_log_ids">
	      							<tree>
	      								<field name="create_date"/>
	      								<field name="create_uid"/>
	      							</tree>
	      						</field>
	      					</page>
	      				</notebook>
	      			</sheet>
      			</form>
      		</field>
		</record>      		
      	
     <record id="action_student_master" model="ir.actions.act_window">
            <field name="name">Student</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">penygon.student</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
      </record>
      
      
      
</odoo>